# Path to YOLO weights (fire/smoke). Default is the bundled nano model.
FIRE_WEIGHTS=models/fire-smoke-yolov8n.pt
# cpu | cuda | cuda:0 | mps
FIRE_DEVICE=cpu
# Detection thresholds
FIRE_CONF=0.35
FIRE_IOU=0.5
FIRE_IMGSZ=640
# Run the detector every N frames (1 = every frame). Raise on slow CPUs.
FIRE_DETECT_EVERY=1
# Alert logic: how many consecutive positive detection passes before an alert fires,
# and the minimum seconds between alerts for the same source.
FIRE_MIN_CONSECUTIVE=3
FIRE_ALERT_COOLDOWN=30
# Optional: POST a JSON payload here on every alert
FIRE_WEBHOOK_URL=
# Loop local video files when they reach the end
FIRE_LOOP_FILES=true
# Server bind
FIRE_HOST=0.0.0.0
FIRE_PORT=8000
# Comma-separated sources to start automatically, e.g.
# FIRE_SOURCES=rtsp://user:pass@10.0.0.5:554/stream1,/videos/test.mp4
FIRE_SOURCES=
