# Everything below can be left as-is. Most options are also editable live in the UI (Settings page);
# values set in the UI are stored in data/settings.json and override these defaults.

# Model weights + device need a restart to change.
FIRE_WEIGHTS=models/fire-smoke-yolov8n.pt
# cpu | cuda | cuda:0 | mps
FIRE_DEVICE=cpu

# Ports
FIRE_HOST=0.0.0.0
FIRE_PORT=8000
FRONTEND_PORT=5173

# Detection defaults (editable in UI)
FIRE_CONF=0.35
FIRE_IOU=0.5
FIRE_IMGSZ=640
FIRE_DETECT_EVERY=1

# Alert defaults (editable in UI)
FIRE_MIN_CONSECUTIVE=3
FIRE_ALERT_COOLDOWN=30

# Notification defaults (editable in UI)
FIRE_WEBHOOK_URL=
FIRE_TELEGRAM_BOT_TOKEN=
FIRE_TELEGRAM_CHAT_ID=
FIRE_SMTP_HOST=
FIRE_SMTP_PORT=587
FIRE_SMTP_USER=
FIRE_SMTP_PASSWORD=
FIRE_SMTP_FROM=
FIRE_SMTP_TO=

# Sources to add automatically on startup (comma-separated); sources added in the UI persist on their own.
FIRE_SOURCES=

# Where snapshots/clips/recordings/settings are stored
FIRE_DATA_DIR=data
